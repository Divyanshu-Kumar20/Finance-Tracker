              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Senior Developer Salary\",\n  \"amount\": 5000,\n  \"type\": \"income\",\n  \"category\": \"Employment\",\n  \"date\": \"2026-07-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "{{transactionId}}"]
