              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?month=2026/07",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"],
              "query": [
                {
                  "key": "month",
                  "value": "2026/07"
                }
              ]
            }
          }
        },
        {
          "name": "Get Summary - Success",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/summary?month=2026-07",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "summary"],
